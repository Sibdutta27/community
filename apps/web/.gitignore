# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# admin SPA bundle staged here by the NAS delivery packaging script
# (see feat/nas-delivery). Build output, not source: it is a copy of
# apps/admin's Vite build and would drift the moment apps/admin changes.
# On Vercel the admin is deployed as its own project, and the /backend
# proxy this bundle depends on is inert there, so it is never needed.
public/admin/
