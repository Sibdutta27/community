// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// user model
model User {
  id String @id @default(uuid())

  serial   BigInt  @unique @default(autoincrement())
  publicId String? @unique

  name     String?
  email    String  @unique
  password String
  role     Role    @default(USER)

  enrollment          Enrollment?
  serviceAppointments ServiceRegistration[]
  eventRegistrations  EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastActiveAt DateTime?
  documents    Document[]
  feedback     Feedback[]
}

// Define user role for user model
enum Role {
  USER
  ADMIN
  MODERATOR
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Enrollment model
model Enrollment {
  id     String @id @default(uuid())
  userId String @unique

  status EnrollmentStatus @default(DRAFT)

  firstName String?
  lastName  String?

  dateOfBirth         DateTime?
  cityOfBirth         String?
  municipalityOfBirth String?
  countryOfBirth      String?

  sex                Sex?
  gender             Gender?
  genderSelfDescribe String? // free text when gender = SELF_DESCRIBE

  maritalStatus MaritalStatus?
  occupation    String?

  identity Identity?

  hasChildren      Boolean?
  hasMinorChildren Boolean? // "children under 18?"

  yucayeke        String? // selected yucayeke (option list TBD later)
  yucayekeUnknown Boolean? // "I don't know my Yucayeke"

  signatureName String? // confirmation e-signature (full legal name)
  signatureDate DateTime?
  agreedToTerms Boolean?

  consentAccepted Boolean @default(false)

  approvalDate DateTime?

  user User @relation(fields: [userId], references: [id])

  contact   Contact?
  consent   EnrollmentConsent[]
  ancestry  Ancestry[]
  documents Document[]
  steps     EnrollmentStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enrollment status enum
enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Gender enum — client spec 2026-07-08: Woman / Man / Two-Spirit (+ self-describe).
// An Arawak-language term for Two-Spirit is pending from the client; add it here
// (plus the web option arrays and en/es messages) when it arrives.
enum Gender {
  WOMAN
  MAN
  TWO_SPIRIT
  SELF_DESCRIBE
}

// Sex (biological) enum — client spec 2026-07-08: Female / Male / Intersex.
// The field is optional; leaving it unset covers "prefer not to say".
enum Sex {
  MALE
  FEMALE
  INTERSEX
}

// Marital status enume
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  DOMESTIC_PARTNERSHIP
}

// Self-identification enum
enum Identity {
  ARAWAK
  KALINAGO
  GARIFUNA
  TAINO
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

model EnrollmentStep {
  id           String @id @default(uuid())
  enrollmentId String
  stepNumber   Int

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stepNumber])
  @@index([enrollmentId])
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Ancestry model — kinship rows for the maternal (step 2) and paternal (step 3)
// lineage of the enrollee, matching the Figma "Maternal / Paternal Kinship" forms.
model Ancestry {
  id           String @id @default(uuid())
  enrollmentId String

  relation AncestryRelation

  name           String?
  dateOfBirth    DateTime?
  nationality    String?
  municipality   String?
  yucayeke       String?
  isBorikuaTaino Boolean?

  // Admin-attested verification of indigenous ancestry (member edits reset it)
  verificationStatus AncestryVerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, relation])
  @@index([enrollmentId])
}

// How an ancestry entry was verified as indigenous (e.g. mtDNA haplogroup vs documentary genealogy)
enum AncestryVerificationStatus {
  UNVERIFIED
  VERIFIED_DNA
  VERIFIED_GENEALOGY
}

// Ancestry relation enum — the six kinship slots captured across steps 2 & 3.
enum AncestryRelation {
  MOTHER
  MATERNAL_GRANDMOTHER
  MATERNAL_GRANDFATHER
  FATHER
  PATERNAL_GRANDMOTHER
  PATERNAL_GRANDFATHER
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Contact model
model Contact {
  id           String @id @default(uuid())
  enrollmentId String @unique

  email       String
  phoneNumber String
  phoneType   PhoneType
  allowSMS    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
}

// Phone type enume
enum PhoneType {
  MOBILE
  HOME
  WORK
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Document model
model Document {
  id           String  @id @default(uuid())
  enrollmentId String?
  userId       String?

  type   DocumentType
  status DocumentStatus @default(PENDING)

  fileName String
  fileKey  String @unique
  fileUrl  String

  mimeType String
  fileSize Int

  storageProvider StorageProvider @default(S3)

  verifiedByAdmin Boolean @default(false)
  rejectedReason  String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([enrollmentId])
  @@index([userId])
}

// Document type enume
enum DocumentType {
  // User's profile picture
  PROFILE_PICTURE

  // User provided documents
  USER_PHOTO
  BIRTH_CERTIFICATE
  FAMILY_RECORD
  FAMILY_PHOTO
  ADDITIONAL_EVIDENCE

  // Proof-of-identity slots (client 2026-07-08: any 2 of state ID / birth certificate / social security)
  STATE_ID
  SOCIAL_SECURITY_CARD

  // Figma document-evidence slots (kinship / ancestry proof)
  GENEALOGICAL_RECORDS
  KINSHIP_LETTERS
  ORAL_HISTORY
  DNA_TESTING

  // Unknown type for admin uploads.
  UNKNOWN
}

// Document status enume
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Storage provider enume
enum StorageProvider {
  S3
  MINIO
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Enrollment consent table
model EnrollmentConsent {
  id           String @id @default(uuid())
  enrollmentId String
  consentId    String

  accepted   Boolean
  acceptedAt DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  consent    Consent    @relation(fields: [consentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([enrollmentId, consentId])
  @@index([enrollmentId])
  @@index([consentId])
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Consent table
model Consent {
  id      String @id @default(uuid())
  key     String
  version Int
  title   String
  content String @db.Text

  required Boolean @default(true)
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  enrollments EnrollmentConsent[]

  @@unique([key, version])
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Cultural connection reference table (kept as a lookup; the enrollment join
// step was removed in the Figma rebuild).
model CulturalConnection {
  id String @id @default(uuid())

  key         String  @unique
  description String  @db.Text
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  icon        String? // store icon name or URL

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  isFeatured Boolean       @default(false)
  status     ServiceStatus @default(ACTIVE)

  // Contact / Meta
  location String?
  phone    String?
  email    String?

  // CTA
  actionType  ActionType @default(EXTERNAL)
  actionLabel String? // "Schedule Appointment", "Request Consultation"
  actionUrl   String? // external or internal link

  // optional: for internal routing
  actionRoute String? // "/apply", "/register"

  highlights String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations ServiceRegistration[]

  @@index([categoryId])
  @@index([isFeatured])
}

model ServiceCategory {
  id   String  @id @default(uuid())
  key  String  @unique
  name String
  icon String? // store icon name or URL

  services Service[]

  createdAt DateTime @default(now())
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ActionType {
  INTERNAL // open page inside app
  EXTERNAL // redirect to website
  MODAL // open popup (form, booking)
  NONE // no action, just display info
}

model ServiceRegistration {
  id        String @id @default(uuid())
  serviceId String
  userId    String

  date   DateTime
  status String

  service Service @relation(fields: [serviceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?

  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id])

  // Date & Time
  startDateTime DateTime
  endDateTime   DateTime?

  // Location
  locationType LocationType @default(PHYSICAL)
  location     String? // "Zoom", "Sacred Grounds"
  meetingUrl   String? // for virtual events

  // Meta
  maxCapacity Int?
  isFeatured  Boolean @default(false)
  externalUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations EventRegistration[]

  @@index([categoryId])
  @@index([startDateTime])
}

model EventCategory {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  icon        String?

  events Event[]
}

model EventRegistration {
  id      String @id @default(uuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([eventId])
}

enum LocationType {
  PHYSICAL
  VIRTUAL
}

////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////

// Feedback model — in-app "suggestions box" / work orders raised by members and
// closed-beta testers from the floating feedback widget in apps/web.
// `userId` is nullable on purpose: signed-out visitors may report an issue too.
model Feedback {
  id     String  @id @default(uuid())
  userId String?

  // What the member wrote, in their own words.
  message String @db.Text

  // Captured automatically by the widget so the tester never has to describe
  // where they were: the page they submitted from and the UI language.
  pageUrl String
  locale  String

  // Browser user-agent, forwarded by the web BFF (the API only ever sees the
  // BFF's own agent, so it cannot read this off the request itself).
  userAgent String?

  // Optional screenshot / attachment stored in the same private bucket as
  // Documents. Only the storage key is persisted; reads are presigned.
  attachmentKey      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
