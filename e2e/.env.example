# Copy to e2e/.env and fill in. All optional — tests that need credentials skip if unset.

# --- Base URLs (where each app is served) ---
# Member frontend (Next.js). `next dev` defaults to :3000.
WEB_BASE_URL=http://localhost:3000
# Admin panel (Vite). `vite` defaults to :5173.
ADMIN_BASE_URL=http://localhost:5173

# --- Member test account (enables authenticated web flows) ---
# A seeded/known member able to sign in and reach the dashboard/enrollment.
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=

# --- Admin test account (enables admin panel flows) ---
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
